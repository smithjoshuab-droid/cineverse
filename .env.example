# CineVerse environment configuration — copy to .env and fill in your keys.

# REQUIRED — TMDB key: v3 API key (32 hex chars) or v4 Read Access Token (JWT). Auto-detected.
# Free at https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# OPTIONAL — OMDb key for real IMDb ratings on detail pages (falls back to TMDB score).
# Free at https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=

# OPTIONAL — keeps login sessions valid across restarts.
SESSION_SECRET=

# OPTIONAL — HTTP port (default 3000).
PORT=3000

# OPTIONAL — ISO country code for provider availability (default US).
TMDB_REGION=US
