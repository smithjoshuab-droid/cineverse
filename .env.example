# Required: TMDB v3 API key (32 chars) or v4 read access token (long JWT).
# Get yours free at https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_key_here

# Optional but recommended: OMDB API key for real IMDb ratings on detail pages.
# Free tier (1k requests/day) at https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=

# Set to a long random string in production so sessions survive restarts.
# Leave blank to auto-generate (sessions reset on every restart).
SESSION_SECRET=

# HTTP port. On Render this is set automatically by the platform.
PORT=3000

# ISO country code for streaming-provider availability. Default: US.
TMDB_REGION=US

# Set to "production" when deployed (enables secure cookies behind HTTPS).
# Render sets this automatically.
NODE_ENV=
